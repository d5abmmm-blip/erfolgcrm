{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "vite-plugin-pwa/react",
      "vite-plugin-pwa/info"
    ],
    "outDir": "dist",
    "baseUrl": ".",
