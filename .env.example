# ============================================================================
# Production secrets — обязательны в NODE_ENV=production
# Генерация: см. scripts/generate-pii-key.mjs и docs/deploy-checklist.md.
# Все эти переменные ДОЛЖНЫ быть переопределены на проде. Пустые/dev-значения
# приведут к ошибке при старте (для PII_ENCRYPTION_KEY) или к небезопасной
# конфигурации (SESSION_SECRET / DATABASE_URL).
# ============================================================================
#   PII_ENCRYPTION_KEY  — 32 байта base64 (`node scripts/generate-pii-key.mjs`)
#   SESSION_SECRET      — 64+ случайных символов (`openssl rand -base64 64`)
#   DATABASE_URL        — пользователь app_runtime, не суperuser (RLS)
#   DATABASE_OWNER_URL  — пользователь erfolg (owner) — только для миграций
#   REDIS_URL           — managed Redis или защищённый instance
#   S3_ACCESS_KEY/S3_SECRET_KEY — Yandex Object Storage
#   SMTP_HOST/SMTP_USER/SMTP_PASSWORD — почта для уведомлений
#   VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY — Web Push
# ============================================================================

# ============ API (apps/api) ============
NODE_ENV=development
API_PORT=3030
API_HOST=0.0.0.0

# Cookie / session
# В prod заменить: openssl rand -base64 64
SESSION_SECRET=change_me_to_random_64_chars_in_production
COOKIE_DOMAIN=.localhost

# Database (PostgreSQL 16)
# Приложение подключается под app_runtime — без superuser, RLS работает.
# Миграции и seed используют DATABASE_OWNER_URL (erfolg, owner таблиц).
DATABASE_URL=postgresql://app_runtime:app_runtime_dev_only@localhost:5432/erfolg_dev
DATABASE_OWNER_URL=postgresql://erfolg:dev_only_password@localhost:5432/erfolg_dev
# Отдельная база для автотестов (vitest подменяет DATABASE_URL на неё в setup.ts).
# Бутстрап: docs/dev-test-db.md
TEST_DATABASE_URL=postgresql://app_runtime:app_runtime_dev_only@localhost:5432/erfolg_test

# Redis (sessions + queues)
REDIS_URL=redis://localhost:6379

# Хранилище файлов: STORAGE_DRIVER=local (dev) | s3 (prod, Yandex Object Storage)
# В dev оставляем local — presigned URLs идут через /api/v1/storage HMAC.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=
STORAGE_LOCAL_SECRET=
# Публичный адрес приложения — для ссылок, которые видит клиент (трек-ссылка
# в письмах при смене статуса) и вебхуков Telegram. На проде: https://crm.erfolgmt.ru
# Пусто → письма клиенту уходят без трек-ссылки (деградация, ничего не ломается).
API_PUBLIC_URL=

# Yandex Object Storage (S3-compatible) — заполнять при STORAGE_DRIVER=s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=erfolgcrm-dev
# Опционально per-tenant bucket: erfolgcrm-prod-{tenant} (плейсхолдер {tenant} заменяется на UUID)
S3_BUCKET_TEMPLATE=
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Опц.: KMS-ключ для server-side encryption (Yandex KMS key id)
S3_KMS_KEY_ID=

# Очередь фоновой чистки осиротевших S3-объектов
# Через сколько после soft-delete удалять объект из bucket'а (часы).
STORAGE_PURGE_DELAY_HOURS=24
# Запускать ли воркеры внутри API-процесса (true в dev/single-node, false если воркеры — отдельный процесс)
WORKERS_ENABLED=true

# Yandex KMS — ключи шифрования ПДн (per-tenant)
YC_KMS_KEY_ID=

# Web Push — VAPID-ключи (генерируются командой `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:erfolgmt@mail.ru

# ============ PII шифрование (ОБЯЗАТЕЛЬНО на проде) ============
# Симметричный ключ pgcrypto для шифрования ПДн (ФИО/телефон/адрес физлиц
# + контактные лица + Telegram токены). При утечке БД без этого ключа атакующий
# видит только зашифрованный bytea.
#
# Генерация (запустить ОДИН раз и сохранить в защищённом vault):
#   node scripts/generate-pii-key.mjs
#
# В NODE_ENV=production отсутствие ключа или dev-fallback значение → ошибка
# при первом обращении к шифрованной таблице (см. packages/db/src/crypto.ts).
# В dev/test fallback допускается (warning в логах).
#
# ВАЖНО: потеря ключа = безвозвратная потеря зашифрованных ПДн. Храни копию
# отдельно от БД (например, в менеджере паролей директора + offline backup).
PII_ENCRYPTION_KEY=dev-only-pii-key-DO-NOT-USE-IN-PROD

# ============ SMTP (для invoice reminder воркера) ============
# В dev — MailHog: SMTP_HOST=localhost SMTP_PORT=1025
# В prod — российский провайдер (Yandex SMTP, Mail.ru Business и т.п.)
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=erfolgmt@mail.ru
# Включить cron-расписания фоновых рассылок (ставить true только если SMTP настроен)
INVOICE_REMINDER_ENABLED=false

# Логирование / мониторинг
LOG_LEVEL=info
SENTRY_DSN=

# Brute-force защита логина (попыток в минуту с IP). По умолчанию 10.
LOGIN_RATE_LIMIT=10

# CORS: разрешённые origin'ы в production (через запятую). В dev localhost
# разрешён автоматически. Если web и api на одном домене — можно оставить пустым.
CORS_ORIGINS=

# ============ Web (apps/web) ============
VITE_API_URL=http://localhost:3030
VITE_TENANT_DOMAIN_SUFFIX=.localhost:5173
# Личный режим (single-tenant): организация подставляется автоматически,
# поле «Код организации» на логине скрыто. Пусто — мультиарендный вход.
VITE_DEFAULT_TENANT=erfolg

# ============ Telegram (модуль в apps/api) ============
# токен общего бота для разработки (per-tenant токены — в БД)
TELEGRAM_DEV_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=https://localhost:3000/api/v1/telegram/webhook

# ============ AI-ассистент (модуль ai-assistant в apps/api) ============
# Не задано — ассистент показывает «не настроен» и не делает запросов.
# Протокол: 'openai' (по умолчанию) — POST {base}/chat/completions; либо
# 'anthropic' — POST {base}/v1/messages (нужно для z.ai GLM Coding Plan).
LLM_API_STYLE=
# OpenAI-совместимо:   LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=deepseek/deepseek-chat
# z.ai GLM (anthropic): LLM_BASE_URL=https://api.z.ai/api/anthropic  LLM_MODEL=glm-4.6 (умеет текст и картинки)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
